# The /contact form sends through Resend. Without RESEND_API_KEY and a from
# address the site falls back to a logging sender so local development works,
# and the route handler refuses to use that fallback in production.

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain verified in Resend, e.g. "Arbour <hello@usearbour.com>"
# usearbour.com is verified (DKIM + SPF) on the Resend team. The old name,
# WAITLIST_FROM_EMAIL, is still read as a fallback.
CONTACT_FROM_EMAIL="Arbour <support@usearbour.com>"

# Where the /contact form lands. Defaults to SITE.contactEmail.
CONTACT_TO_EMAIL=support@usearbour.com

# Used for canonical URLs, the sitemap and Open Graph. Match the production
# host, which redirects the apex domain to www.
NEXT_PUBLIC_SITE_URL=https://www.usearbour.com

# Optional HTML verification tokens from Google Search Console and Bing
# Webmaster Tools. Use the content value only, not the whole meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Meta Pixel dataset id. Leave blank locally so dev never reports to production.
NEXT_PUBLIC_META_PIXEL_ID=

# Reddit Pixel id (production: a2_jvhjwz8lt05e). Leave blank locally for the
# same reason.
NEXT_PUBLIC_REDDIT_PIXEL_ID=

# Server-only key for Arby Help. Never prefix this with NEXT_PUBLIC_.
# Uses claude-haiku-5-5 at low effort through the Anthropic Messages API.
ANTHROPIC_API_KEY=
