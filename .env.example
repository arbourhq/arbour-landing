# Waitlist. Resend is the temporary home, the destination is Pipedrive.
# Without RESEND_API_KEY and WAITLIST_FROM_EMAIL the site falls back to a
# logging provider so local development works, and the route handler refuses
# to use that fallback in production.

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain verified in Resend, e.g. "Arbour <hello@usearbour.com>"
# usearbour.com is verified (DKIM + SPF) on the Resend team.
WAITLIST_FROM_EMAIL="Arbour <support@usearbour.com>"

# Optional. The "Waitlist" segment. https://resend.com/segments
# Resend renamed Audiences to Segments; the deprecated /audiences endpoints the
# waitlist provider calls still accept a segment ID, so this stays as is until
# the whole thing moves to Pipedrive.
# Without it, signups still get the confirmation email but are not stored.
RESEND_AUDIENCE_ID=5f327a1b-e5e6-46fe-bc7d-11cce83916a6

# Optional. Gets a one-line email per signup.
WAITLIST_NOTIFY_EMAIL=support@usearbour.com

# Where the /contact form lands. Defaults to SITE.contactEmail.
CONTACT_TO_EMAIL=support@usearbour.com

# Used for canonical URLs and Open Graph. Defaults to https://usearbour.com
NEXT_PUBLIC_SITE_URL=https://usearbour.com
