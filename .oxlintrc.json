{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "nextjs",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    // The automatic JSX runtime is on, so React does not need to be in scope.
    "react/react-in-jsx-scope": "off",
    // Side-effect imports are how stylesheets get loaded.
    "import/no-unassigned-import": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"]
}
