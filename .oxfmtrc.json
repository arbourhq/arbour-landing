{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Markdown is prose, and AGENTS.md is regenerated by Next's tooling between the
  // BEGIN/END markers — formatting it just creates churn.
  "ignorePatterns": ["**/*.md"],
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "src/app/globals.css",
    "functions": ["clsx", "cn", "cva", "tw"]
  }
}
